<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <!-- Einstellungen (Funk aus) -->
    <ScrollView
        android:id="@+id/setup_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <de.funkgeraet.walkie.OrbView
                android:layout_width="match_parent"
                android:layout_height="230dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-14dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.3"
                android:shadowColor="#00e5ff"
                android:shadowRadius="24"
                android:text="FUNKGERÄT"
                android:textColor="#ffffff"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:text="VERSCHLÜSSELT · WELTWEIT · SOFORT"
                android:textColor="#8000e5ff"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/Label" android:text="RUFNAME" />
                <EditText
                    android:id="@+id/name"
                    style="@style/Field"
                    android:hint="z. B. Robert"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="20" />

                <TextView style="@style/Label" android:layout_marginTop="14dp" android:text="KANAL" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/channel"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:hint="falke-4271"
                        android:inputType="textNoSuggestions"
                        android:maxLength="40" />
                    <Button
                        android:id="@+id/random"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_glass"
                        android:text="🎲"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🔒 Auf allen Handys genau gleich eintippen. Der Kanal ist zugleich das Passwort – alles wird damit verschlüsselt."
                    android:textColor="#8a96a8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/server_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="4dp"
                    android:text="⚙ Vermittlungsserver"
                    android:textColor="#5aa9c9"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/server"
                    style="@style/Field"
                    android:fontFamily="monospace"
                    android:hint="broker.hivemq.com:8883"
                    android:inputType="textUri"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/power"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_glow"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15"
                android:text="⏻  FUNK EINSCHALTEN"
                android:textColor="#04121a"
                android:textSize="17sp" />

            <Button
                android:id="@+id/add_widget"
                style="@style/Glass"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="▦  Widget auf den Startbildschirm" />

            <Button
                android:id="@+id/battery"
                style="@style/Glass"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="⚡  Akku-Optimierung ausschalten (empfohlen)"
                android:textColor="#ffcc66" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="3dp"
                android:text="So geht's\n• Alle Handys: gleicher Kanal → Funk einschalten\n• In der App: Knopf gedrückt halten und sprechen\n• Widget: tippen = senden, nochmal tippen = fertig\n• Empfang läuft weiter, auch bei dunklem Bildschirm"
                android:textColor="#7d8aa0"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Funkgerät (an) -->
    <LinearLayout
        android:id="@+id/radio_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#05070b"
        android:orientation="vertical"
        android:visibility="gone">

        <de.funkgeraet.walkie.RadioView
            android:id="@+id/radio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingBottom="14dp">
            <Button android:id="@+id/share" style="@style/Glass" android:layout_width="0dp" android:layout_weight="1"
                android:text="➦ Einladen" />
            <Button android:id="@+id/add_widget2" style="@style/Glass" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="▦ Widget" />
            <Button android:id="@+id/battery2" style="@style/Glass" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="⚡ Akku" android:textColor="#ffcc66" />
            <Button android:id="@+id/off" style="@style/Glass" android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:background="@drawable/btn_off" android:text="⏻ Aus"
                android:textColor="#ff8a80" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
