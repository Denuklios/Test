<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape>
        <gradient android:angle="0" android:startColor="#5500e5ff" android:endColor="#552979ff" />
        <stroke android:width="1.5dp" android:color="#00e5ff" /><corners android:radius="20dp" /></shape></item>
    <item android:state_pressed="true"><shape>
        <solid android:color="#3300e5ff" /><stroke android:width="1dp" android:color="#00e5ff" /><corners android:radius="20dp" /></shape></item>
    <item><shape>
        <solid android:color="#12ffffff" /><stroke android:width="1dp" android:color="#2affffff" /><corners android:radius="20dp" /></shape></item>
</selector>
