<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#2B2622</color>
    <color name="muted">#6E645B</color>
    <color name="linen">#F3EEE6</color>
    <color name="card">#FFFFFF</color>
    <color name="pine">#2F4A3A</color>
    <color name="pine_soft">#DCE6DE</color>
    <color name="berry">#B23A3A</color>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/berry</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/pine</item>
        <item name="colorSecondaryContainer">@color/pine_soft</item>
        <item name="colorOnSecondaryContainer">@color/pine</item>
        <item name="android:colorBackground">@color/linen</item>
        <item name="android:windowBackground">@color/linen</item>
        <item name="android:statusBarColor">@color/pine</item>
        <item name="android:navigationBarColor">@color/linen</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="AppTheme.Full" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#000000</item>
    </style>
</resources>
