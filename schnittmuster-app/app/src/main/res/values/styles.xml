<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#3A1D17</color>
    <color name="paper">#F6EFE2</color>
    <color name="red">#A3201D</color>
    <color name="red_dark">#7D1714</color>
    <color name="green">#2E5A3C</color>
    <color name="green_soft">#E6F0E8</color>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/red</item>
        <item name="colorOnPrimary">#FFF7EC</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorSecondaryContainer">@color/green_soft</item>
        <item name="colorOnSecondaryContainer">@color/green</item>
        <item name="colorSurface">#FFFAF1</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/red_dark</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="AppTheme.Full" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#000000</item>
    </style>
</resources>
