<resources>
  <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:statusBarColor">#0F766E</item>
    <item name="android:navigationBarColor">#FFFFFF</item>
    <item name="android:windowBackground">@color/bg</item>
  </style>
  <style name="WidgetBtn">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:orientation">vertical</item>
    <item name="android:gravity">center_horizontal</item>
    <item name="android:background">@drawable/widget_btn</item>
  </style>
  <style name="WidgetBtnIcon">
    <item name="android:layout_width">40dp</item>
    <item name="android:layout_height">40dp</item>
    <item name="android:padding">10dp</item>
  </style>
  <style name="WidgetBtnText">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">3dp</item>
    <item name="android:textColor">#E6FFFFFF</item>
    <item name="android:textSize">11sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:maxLines">1</item>
  </style>
  <color name="bg">#F1F5F4</color>
  <color name="brand">#0F766E</color>
</resources>
