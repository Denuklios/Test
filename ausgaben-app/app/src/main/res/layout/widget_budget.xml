<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">
  <LinearLayout android:id="@+id/w_info" android:layout_width="match_parent" android:layout_height="0dp"
      android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Noch frei" android:textColor="#D9FFFFFF" android:textSize="12sp" />
    <TextView android:id="@+id/w_free" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="–" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"
        android:maxLines="1" />
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="App öffnen zum Einrichten" android:textColor="#D9FFFFFF" android:textSize="12sp" android:maxLines="1" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:layout_marginTop="8dp">
    <TextView android:id="@+id/w_amount" style="@style/WidgetBtn" android:text="✍️  Betrag" />
    <TextView android:id="@+id/w_photo" style="@style/WidgetBtn" android:layout_marginStart="6dp" android:text="📷  Foto" />
    <TextView android:id="@+id/w_upload" style="@style/WidgetBtn" android:layout_marginStart="6dp" android:text="🖼️  Hochladen" />
  </LinearLayout>
</LinearLayout>
