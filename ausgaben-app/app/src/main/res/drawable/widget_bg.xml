<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient android:startColor="#0B2F35" android:centerColor="#0F4C4A" android:endColor="#115E59" android:angle="315" />
      <corners android:radius="26dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <gradient android:startColor="#00000000" android:endColor="#2214B8A6" android:angle="90" />
      <corners android:radius="26dp" />
      <stroke android:width="1dp" android:color="#555EEAD4" />
    </shape>
  </item>
</layer-list>
