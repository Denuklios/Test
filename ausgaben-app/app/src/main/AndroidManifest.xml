<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <!-- Nur Apps mit derselben Signatur (Helfer „AusgabenKompass Zahlungen“) dürfen Zahlungen melden -->
  <permission android:name="de.anderssohn.ausgaben.permission.ZAHLUNG" android:protectionLevel="signature" />
  <uses-permission android:name="de.anderssohn.ausgaben.permission.ZAHLUNG" />
  <queries><package android:name="de.anderssohn.ausgaben.zahlungen" /></queries>
  <application
      android:label="AusgabenKompass"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:allowBackup="true"
      android:theme="@style/AppTheme">
    <activity android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter android:label="Als Ausgabe erfassen">
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
      <intent-filter android:label="Als Ausgabe erfassen">
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
      <intent-filter android:label="Kontoauszug importieren">
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="application/pdf" />
        <data android:mimeType="text/csv" />
        <data android:mimeType="text/comma-separated-values" />
      </intent-filter>
    </activity>
    <receiver android:name=".PaymentReceiver" android:exported="true"
        android:permission="de.anderssohn.ausgaben.permission.ZAHLUNG">
      <intent-filter>
        <action android:name="de.anderssohn.ausgaben.PAYMENT" />
      </intent-filter>
    </receiver>
    <receiver android:name=".BudgetWidget" android:exported="true" android:label="AusgabenKompass">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
    </receiver>
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="de.anderssohn.ausgaben.files"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
    </provider>
  </application>
</manifest>
