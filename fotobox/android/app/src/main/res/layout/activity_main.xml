<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Kopfzeile wie im Admin-Bereich -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="FotoBox"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="FotoBox"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:text="FOTOS &amp; DATEIEN"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_avatar"
            android:fontFamily="@font/outfit_semibold"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Anmeldung -->
            <LinearLayout
                android:id="@+id/setupBox"
                style="@style/Card"
                android:layout_marginTop="12dp"
                android:padding="26dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="FotoBox"
                    android:src="@drawable/logo" />

                <TextView
                    style="@style/Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="FotoBox"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:text="Mit deinem Server verbinden"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server-Adresse (zu Hause)" />
                <EditText
                    android:id="@+id/serverUrl"
                    style="@style/Input"
                    android:hint="192.168.1.10"
                    android:inputType="textUri" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Benutzername" />
                <EditText
                    android:id="@+id/userName"
                    style="@style/Input"
                    android:inputType="text" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Passwort" />
                <EditText
                    android:id="@+id/password"
                    style="@style/Input"
                    android:inputType="textPassword" />

                <CheckBox
                    android:id="@+id/includeExisting"
                    style="@style/Check"
                    android:layout_marginTop="10dp"
                    android:checked="true"
                    android:text="Auch alle vorhandenen Fotos sichern" />

                <Button
                    android:id="@+id/loginBtn"
                    style="@style/BtnPrimary"
                    android:text="Anmelden" />

                <TextView
                    android:id="@+id/loginMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_warn"
                    android:fontFamily="@font/outfit_semibold"
                    android:padding="12dp"
                    android:textColor="#B91C1C"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Jede Person meldet sich mit dem eigenen Konto an."
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Hauptansicht -->
            <LinearLayout
                android:id="@+id/mainBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Übersicht"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/permWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_warn"
                    android:fontFamily="@font/outfit_semibold"
                    android:padding="12dp"
                    android:text="Kein voller Zugriff auf Fotos. Hier tippen und „Alle erlauben“ wählen."
                    android:textColor="#B91C1C"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Kennzahlen -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Card"
                        android:layout_width="0dp"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Gesichert" />
                        <TextView android:id="@+id/statCount" style="@style/StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Card"
                        android:layout_width="0dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Letzter Abgleich" />
                        <TextView android:id="@+id/statLast" style="@style/StatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:text="–" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Status + Aktionen -->
                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sicherung" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/outfit_semibold"
                        android:textColor="@color/purple"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Button android:id="@+id/syncBtn" style="@style/BtnPrimary" android:layout_marginTop="14dp" android:text="Jetzt Fotos sichern" />
                    <Button android:id="@+id/uploadBtn" style="@style/BtnSecondary" android:text="Dateien auswählen und hochladen" />
                    <Button android:id="@+id/browserBtn" style="@style/BtnSecondary" android:text="Meine Dateien im Browser öffnen" />
                </LinearLayout>

                <!-- Einstellungen -->
                <LinearLayout style="@style/Card">
                    <TextView
                        style="@style/Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Einstellungen" />

                    <CheckBox android:id="@+id/optVideos" style="@style/Check" android:text="Videos auch sichern" />
                    <CheckBox android:id="@+id/optCameraOnly" style="@style/Check" android:text="Nur Kamera-Fotos (keine WhatsApp, Screenshots …)" />
                    <CheckBox android:id="@+id/optCharging" style="@style/Check" android:text="Nur sichern, wenn das Handy lädt" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Gesichert wird automatisch, sobald du im WLAN bist und der Server erreichbar ist – also zu Hause. Fotos landen in „Fotos/Jahr/Monat“, ausgewählte oder geteilte Dateien in „Dateien“."
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/logoutBtn"
                    style="@style/BtnSecondary"
                    android:layout_marginTop="0dp"
                    android:text="⏻  Abmelden / anderer Server"
                    android:textColor="@color/red" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
