<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Anmeldung -->
        <LinearLayout
            android:id="@+id/setupBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mit deinem Server verbinden"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Server-Adresse (zu Hause im WLAN)" />

            <EditText
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="http://192.168.1.10:8090"
                android:inputType="textUri" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Benutzer" />

            <EditText
                android:id="@+id/userName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Passwort" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />

            <CheckBox
                android:id="@+id/includeExisting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Auch alle vorhandenen Fotos sichern"
                android:checked="true" />

            <Button
                android:id="@+id/loginBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Verbinden" />

            <TextView
                android:id="@+id/loginMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#D33" />
        </LinearLayout>

        <!-- Hauptansicht -->
        <LinearLayout
            android:id="@+id/mainBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/permWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kein voller Zugriff auf Fotos. Hier tippen, um ihn zu erlauben."
                android:textColor="#D33"
                android:visibility="gone" />

            <Button
                android:id="@+id/syncBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Jetzt Fotos sichern" />

            <Button
                android:id="@+id/uploadBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dateien auswählen und hochladen" />

            <Button
                android:id="@+id/browserBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meine Dateien im Browser öffnen" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Einstellungen"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/optVideos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Videos auch sichern" />

            <CheckBox
                android:id="@+id/optCameraOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nur Kamera-Fotos (keine WhatsApp, Screenshots …)" />

            <CheckBox
                android:id="@+id/optCharging"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nur sichern, wenn das Handy lädt" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gesichert wird automatisch, sobald du im WLAN bist und der Server erreichbar ist – also zu Hause. Fotos landen im Ordner „Fotos/Jahr/Monat“, ausgewählte oder geteilte Dateien im Ordner „Dateien“."
                android:textSize="13sp" />

            <Button
                android:id="@+id/logoutBtn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Abmelden / anderer Server" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
